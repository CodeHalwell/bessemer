+/// Whether a container read under its parent's lock may be read under its
+/// own, taken with [`TryLock`]. A debug build of CPython asserts that a dict
+/// it iterates is locked by the thread's innermost critical section, which
+/// a lock taken this way is not, so such a build keeps a reference to every
+/// nested container and reads it after unlocking, as before.
+#[cfg(Py_GIL_DISABLED)]
+const NESTED_LOCKS: bool = cfg!(not(py_sys_config = "Py_DEBUG"));
+
+/// `PyMutex` states, from CPython's `cpython/pylock.h`, whose inline lock
+/// and unlock compile these values into every extension module. Any other
+/// state of a locked mutex means a thread is parked waiting for it.
+#[cfg(Py_GIL_DISABLED)]
+const UNLOCKED: u8 = 0;
+#[cfg(Py_GIL_DISABLED)]
+const LOCKED: u8 = 1;
+
+/// The state byte of `object`'s lock.
+///
+/// # Safety
+///
+/// `object` must be alive for as long as the result is used.
+#[cfg(Py_GIL_DISABLED)]
+#[inline]
+unsafe fn lock_state<'a>(object: *mut ffi::PyObject) -> &'a std::sync::atomic::AtomicU8 {
+    // SAFETY: the caller's. `PyMutex` is a transparent wrapper of the byte.
+    unsafe { &*(&raw const (*object).ob_mutex).cast::<std::sync::atomic::AtomicU8>() }
+}
+
+/// Whether another thread is waiting for the lock this thread holds on
+/// `object`. A long read under the lock stops at the next value when one
+/// is, so the wait is bounded by one value.
+///
+/// # Safety
+///
+/// `object` must be alive and locked by this thread.
+#[cfg(Py_GIL_DISABLED)]
+#[inline]
+unsafe fn waited_for(object: *mut ffi::PyObject) -> bool {
+    // SAFETY: the caller's.
+    unsafe { lock_state(object) }.load(std::sync::atomic::Ordering::Relaxed) != LOCKED
+}
+
+/// An object's lock, held without a critical section and taken only when it
+/// is free.
+///
+/// Entering a critical section can block, and a thread that blocks gives up
+/// the critical sections it is already in. A value borrowed from a locked
+/// container is alive only while that container stays locked, so its own
+/// lock cannot be waited for. This takes the lock the way CPython's inline
+/// `PyMutex_Lock` does when it is free, and otherwise gives up.
+///
+/// While one is held the thread must not block, run Python code, or call
+/// anything that locks the same object (a critical section on it would wait
+/// for this thread forever). The encoder only reads sizes, items and scalar
+/// values there.
+#[cfg(Py_GIL_DISABLED)]
+struct TryLock(*mut ffi::PyObject);
+
+#[cfg(Py_GIL_DISABLED)]
+impl TryLock {
+    /// # Safety
+    ///
+    /// `object` must stay alive until the lock is dropped.
+    #[inline]
+    unsafe fn acquire(object: *mut ffi::PyObject) -> Option<Self> {
+        use std::sync::atomic::Ordering::SeqCst;
+        // SAFETY: the caller's.
+        unsafe { lock_state(object) }
+            .compare_exchange(UNLOCKED, LOCKED, SeqCst, SeqCst)
+            .ok()
+            .map(|_| Self(object))
+    }
+}
+
+#[cfg(Py_GIL_DISABLED)]
+impl Drop for TryLock {
+    #[inline]
+    fn drop(&mut self) {
+        use std::sync::atomic::Ordering::SeqCst;
+        // SAFETY: the object is alive and this thread holds its lock. With
+        // no waiter the state goes straight back; otherwise `PyMutex_Unlock`
+        // wakes one, exactly as CPython's inline unlock does.
+        unsafe {
+            if lock_state(self.0)
+                .compare_exchange(LOCKED, UNLOCKED, SeqCst, SeqCst)
+                .is_err()
+            {
+                ffi::PyMutex_Unlock(&raw mut (*self.0).ob_mutex);
+            }
+        }
+    }
+}
